# Copy to .env and fill in only the settings needed by the example you run.
# Never commit real API keys or database passwords.
ARK_API_KEY=
DEEPSEEK_API_KEY=

# Used by 02_llm基础/demo1.py and demo2.py.
AGENT_MODEL=doubao-seed-2-1-pro-260628
AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Used by 05_mysql/demo1. Create the database and import the orders table first.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=order_app
MYSQL_PASSWORD=
MYSQL_DATABASE=order_demo
